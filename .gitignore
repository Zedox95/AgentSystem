# Runtime state: does not belong in version control. Excluded wholesale
# (not just the individual subdirectories) so that no new state/* folder
# added later can accidentally slip into a commit.
state/
logs/
adapters/playwright/node_modules/

# Python
__pycache__/
*.py[cod]
.venv/

# Local overrides often contain paths or access credentials.
.claude/settings.local.json

# Never checked in - see AGENTS.md section 20.
*.env
.env
.env.*
*.key
*.pem
id_rsa
id_ed25519
credentials.json
auth.json
