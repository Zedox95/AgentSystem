{
  "$comment": [
    "MCP servers for EXPLORATORY work. For known, repeatable workflows the",
    "CLIs are the better path: adapters/ufo/ufoctl.py and",
    "adapters/playwright/pwctl.mjs. They are deterministically scriptable,",
    "individually verifiable, and produce smaller context output.",
    "",
    "Both servers hold state across many steps - that is exactly their value",
    "when you first have to feel your way through an unfamiliar interface.",
    "",
    "The browser profile under state/browser-profiles/mcp contains cookies",
    "and session data and is therefore a secret per AGENTS.md section 20:",
    "outside version control, never logged."
  ],

  "mcpServers": {
    "ufo": {
      "command": "C:\\UFO\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\AgentSystem\\adapters\\ufo\\ufo_mcp.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "UFO_ROOT": "C:\\UFO"
      }
    },

    "playwright": {
      "command": "node",
      "args": [
        "C:\\AgentSystem\\adapters\\playwright\\node_modules\\@playwright\\mcp\\cli.js",
        "--user-data-dir", "C:\\AgentSystem\\state\\browser-profiles\\mcp",
        "--output-dir", "C:\\AgentSystem\\logs\\playwright-mcp",
        "--browser", "chromium",
        "--block-service-workers",
        "--console-level", "warning"
      ]
    },

    "shared-memory": {
      "command": "python",
      "args": [
        "C:\\AgentSystem\\adapters\\memory\\memory_mcp.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "AGENTSYSTEM_VAULT": "C:\\Users\\YOURUSERNAME\\Documents\\Obsidian Vault"
      }
    }
  }
}
